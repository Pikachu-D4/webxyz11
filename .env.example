# ─── Media Extraction Provider ───────────────────────────────────
# The URL and API key for the media extraction backend.
# This provider handles URL analysis, format discovery, and download processing.
MEDIA_API_URL=
MEDIA_API_KEY=

# ─── AI Upscaling Provider ───────────────────────────────────────
# The URL and API key for the video super-resolution / upscaling backend.
UPSCALE_API_URL=
UPSCALE_API_KEY=

# ─── Temporary Storage ───────────────────────────────────────────
# Object storage for temporary processed files (e.g. S3, R2, GCS).
STORAGE_URL=
STORAGE_API_KEY=

# ─── Rate Limiting ───────────────────────────────────────────────
# Maximum requests per IP per minute (default: 30)
RATE_LIMIT_RPM=30

# Maximum file size in bytes for processing (default: 2 GB)
MAX_FILE_SIZE=2147483648

# Maximum processing duration in seconds (default: 600)
MAX_PROCESSING_DURATION=600
